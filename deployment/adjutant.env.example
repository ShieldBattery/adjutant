# Discord application token and the one guild this bot is allowed to serve.
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# Exactly two staff channels: webhook alerts in staff-alerts, conversation in command-center.
# REQUEST and OUTPUT must be the same command-center ID. Adjutant can also reply to staff in alerts.
DISCORD_BUG_REPORT_CHANNEL_ID=
DISCORD_BUG_REPORT_WEBHOOK_ID=
DISCORD_REQUEST_CHANNEL_ID=
DISCORD_OUTPUT_CHANNEL_ID=

# Optional comma-separated Discord role IDs. If empty, access is controlled by membership in the
# two private staff channels. This gates human requests in both, never the configured webhook.
DISCORD_ALLOWED_ROLE_IDS=

# Private ShieldBattery app-server origin for its bug-report and game-artifact /internal routes.
# It must be reachable only over the authorized Tailnet path; leaving it empty disables automatic
# report and game-artifact retrieval.
SHIELDBATTERY_PUBLIC_URL=https://shieldbattery.net
SHIELDBATTERY_INTERNAL_URL=

# Codex runs non-interactively via `codex exec`. -p/--profile selects an optional config profile;
# it is not the prompt flag.
CODEX_BIN=codex
CODEX_HOME=/var/lib/adjutant/codex
CODEX_PROFILE=
# Optional override of model = "gpt-6-astra" in config/codex.toml.
CODEX_MODEL=
SHIELDBATTERY_SOURCE_DIR=/workspace/repos/current/ShieldBattery

# Only these variables are inherited by Codex/MCP child processes, in addition to a small built-in
# set such as PATH, HOME, and CODEX_HOME. Never include DISCORD_TOKEN.
CODEX_ENV_PASSTHROUGH=

MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=20
# Generic per-download limit for Discord attachments and bug-report ZIPs.
MAX_DOWNLOAD_BYTES=33554432
# A game request may retrieve all retained flight recordings, replays, and its map. These are the
# maximum artifact count, bytes per artifact, and aggregate game-evidence bytes respectively.
MAX_GAME_ARTIFACTS=32
MAX_GAME_ARTIFACT_BYTES=104857600
MAX_GAME_EVIDENCE_BYTES=268435456
# Archive entry/expansion limits are cumulative across every ZIP in one run.
MAX_ARCHIVE_FILES=128
MAX_EXPANDED_BYTES=268435456
# Per-run Codex audit-stream limits. A truncation marker is stored if any limit is reached.
MAX_CODEX_EVENTS=10000
MAX_CODEX_EVENT_BYTES=33554432
MAX_CODEX_EVENT_LINE_BYTES=524288

# Persistent inspection history and the Tailnet-only web UI. The token must contain at least 32
# bytes. The browser username is `adjutant` and the token is the password.
ADJUTANT_DATABASE_PATH=/var/lib/adjutant/data/adjutant.sqlite3
ADJUTANT_UI_BIND=127.0.0.1:8080
ADJUTANT_UI_TOKEN=
# Optional origin included in Discord status messages (normally a Tailscale HTTPS URL, no path).
ADJUTANT_UI_BASE_URL=
RUN_RETENTION_DAYS=90

RUST_LOG=adjutant=info
LOG_FORMAT=pretty
