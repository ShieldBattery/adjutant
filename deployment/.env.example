# Images published by .github/workflows/container-images.yml. Replace the lowercase placeholder
# owner/repository after creating the GitHub repository. A sha-* tag or digest supports rollbacks.
ADJUTANT_IMAGE=ghcr.io/your-github-owner/adjutant:latest
ADJUTANT_MCP_IMAGE=ghcr.io/your-github-owner/adjutant-mcp:latest

# The source-sync sidecar discovers every non-empty public repository in this GitHub organization,
# refreshes immutable snapshots at the interval below, and retains recent generations so in-flight
# diagnoses never observe a partially updated source tree. No GitHub credential is required.
SOURCE_SYNC_GITHUB_ORG=ShieldBattery
SOURCE_SYNC_INTERVAL_SECONDS=900
SOURCE_SYNC_GIT_DEPTH=200
SOURCE_SYNC_RETENTION_SECONDS=7200
SOURCE_SYNC_MAX_REPOSITORIES=100
# GitHub's API-reported repository sizes provide an early safety check. Monitor or quota the
# source-repos Docker volume if the deployment requires a hard on-disk limit.
SOURCE_SYNC_MAX_REPOSITORY_KIB=1048576
SOURCE_SYNC_MAX_TOTAL_KIB=4194304

# Shared by diagnostics and source retention validation. Retention must be at least this timeout
# plus one source synchronization interval.
JOB_TIMEOUT_SECONDS=1800

# The default exposes the inspector on private HTTPS 443 and the read-only database MCP on private
# HTTPS 8443. Use serve-agent-only.json to keep the MCP agent-local.
TAILSCALE_SERVE_CONFIG=serve.json
