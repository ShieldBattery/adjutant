# Create a pre-authorized key for this long-lived node. The key is only used to join the first time;
# TS_AUTH_ONCE and the persistent state volume preserve the node identity across restarts.
TS_AUTHKEY=
TS_HOSTNAME=adjutant

# Optional, for example: --advertise-tags=tag:adjutant --accept-routes
# Advertised tags must be defined in tagOwners and permitted by the auth key. A tagged auth key
# applies its tags on first login without --advertise-tags; see docs/deployment.md.
TS_EXTRA_ARGS=
