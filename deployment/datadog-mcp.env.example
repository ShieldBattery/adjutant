# Hostname of Datadog's managed MCP for your Datadog site, without a scheme or path. US1 is shown.
# See https://docs.datadoghq.com/mcp_server/setup/ for the regional endpoint selector.
DATADOG_MCP_HOST=mcp.datadoghq.com

# Service Access Token for a dedicated Datadog service account. Give its role MCP Read and only the
# underlying read permissions required by deployment/config/codex.toml. Never grant MCP Write.
DATADOG_MCP_ACCESS_TOKEN=
