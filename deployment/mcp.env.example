# Dedicated PostgreSQL role used only by the diagnostic MCP. Grant it CONNECT/USAGE/SELECT only on
# intentionally exposed views; see docs/database-mcp.md in the source repository. Percent-encode
# special URL characters.
ADJUTANT_MCP_DATABASE_URL=postgresql://adjutant_diagnostics:change-me@shieldbattery-db:5432/shieldbattery

# Exact node FQDN from `tailscale serve status`, without scheme, port, or path. Leave empty for an
# agent-only deployment. Host validation is defense in depth; Tailnet ACLs remain authorization.
ADJUTANT_MCP_TAILSCALE_HOSTNAME=

# Query execution limits. The Rust service and the PostgreSQL read-only transaction both enforce
# these bounds. The row limit is also capped internally, even if this value is raised.
ADJUTANT_MCP_MAX_CONNECTIONS=4
ADJUTANT_MCP_MAX_ROWS=100
ADJUTANT_MCP_MAX_ROW_BYTES=65536
ADJUTANT_MCP_MAX_RESPONSE_BYTES=1048576
ADJUTANT_MCP_MAX_REQUEST_BYTES=65536
ADJUTANT_MCP_STATEMENT_TIMEOUT_MS=5000
ADJUTANT_MCP_LOCK_TIMEOUT_MS=1000

RUST_LOG=adjutant_mcp=info
