# Discord application token and the one guild this bot is allowed to serve.
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# Existing bug-report webhook alerts are read here. Staff requests are read from the request
# channel, and all automatic diagnoses are posted to the output channel.
DISCORD_BUG_REPORT_CHANNEL_ID=
DISCORD_REQUEST_CHANNEL_ID=
DISCORD_OUTPUT_CHANNEL_ID=

# Optional comma-separated Discord role IDs. If empty, access is controlled by membership in the
# private request channel. This setting never applies to webhook alerts in the bug-report channel.
DISCORD_ALLOWED_ROLE_IDS=

# Staff API access used only to exchange a report UUID for metadata and a short-lived logs URL.
SHIELDBATTERY_BASE_URL=https://shieldbattery.net
SHIELDBATTERY_API_TOKEN=

# Codex runs non-interactively via `codex exec`. -p/--profile selects an optional config profile;
# it is not the prompt flag.
CODEX_BIN=codex
CODEX_HOME=/var/lib/adjutant/codex
CODEX_PROFILE=
CODEX_MODEL=
SHIELDBATTERY_SOURCE_DIR=/workspace/shieldbattery

# Only these variables are inherited by Codex/MCP child processes, in addition to a small built-in
# set such as PATH, HOME, and CODEX_HOME. Never include DISCORD_TOKEN or SHIELDBATTERY_API_TOKEN.
CODEX_ENV_PASSTHROUGH=

MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=20
MAX_DOWNLOAD_BYTES=33554432
MAX_ARCHIVE_FILES=128
MAX_EXPANDED_BYTES=268435456
JOB_TIMEOUT_SECONDS=1800
RUST_LOG=adjutant=info
LOG_FORMAT=pretty

